# Copy to .env.local. Values prefixed NEXT_PUBLIC_ are exposed to the browser; nothing else is.

# Equis contracts, set after deploying to X Layer mainnet.
NEXT_PUBLIC_EQUIS_VAULT=
NEXT_PUBLIC_EQUIS_POOL=
NEXT_PUBLIC_EQUIS_ORACLE=
NEXT_PUBLIC_EQUIS_SESSION_DELEGATE=

# Chainlink Data Streams credentials for the /api/prices route (server-side only — never NEXT_PUBLIC_).
# If unset, the app falls back to contracts/.env, which the report fetch script also uses.
CHAINLINK_STREAMS_API_KEY=
CHAINLINK_STREAMS_API_SECRET=
