# Copy to .env.local. Values prefixed NEXT_PUBLIC_ are exposed to the browser; nothing else is.
#
# Every value here is optional. A fresh clone with no .env at all runs against the live X Layer
# mainnet deployment over the public RPC.

# --- Deploying the dashboard (Vercel or anywhere else) ---------------------------------------------

# Strongly recommended in production. The default is X Layer's public RPC, which rate-limits
# datacenter IPs - exactly what a Vercel function reads from. Point this at your own endpoint.
NEXT_PUBLIC_X_LAYER_RPC_URL=
# Optional: a separate, possibly keyed endpoint for server-side reads only. It never reaches the
# browser bundle. Falls back to NEXT_PUBLIC_X_LAYER_RPC_URL, then to the public RPC.
X_LAYER_RPC_URL=

# --- Pointing the app at your own deployment ------------------------------------------------------
# Unset, the app talks to the live contracts listed in the README.
NEXT_PUBLIC_EQUIS_VAULT=
NEXT_PUBLIC_EQUIS_POOL=
NEXT_PUBLIC_EQUIS_ORACLE=
NEXT_PUBLIC_EQUIS_SESSION_DELEGATE=

# --- Telegram bot (scripts/telegram-bot.ts), not needed by the web app ----------------------------
# Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Public https URL of the deployed dashboard, so Telegram can open it as a Mini App.
EQUIS_APP_URL=

# --- Chainlink Data Streams -----------------------------------------------------------------------
# Only for ChainlinkPriceOracle.sol, the alternative oracle adapter that is NOT deployed. RedStone is
# what runs, and it needs no credential. Leave these empty unless you are running that suite.
CHAINLINK_STREAMS_API_KEY=
CHAINLINK_STREAMS_API_SECRET=
