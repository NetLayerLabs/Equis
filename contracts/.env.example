# Copy to .env — Foundry loads it automatically from this directory.

# Optional: pin mainnet fork tests to a block for reproducible, cached runs (0 = latest).
XLAYER_FORK_BLOCK=0

# Chainlink Data Streams API credentials entitled to the xStocks v10 streams.
# Used by `node scripts/fetch-stream-reports.ts` to fetch real signed reports for the fork tests.
CHAINLINK_STREAMS_API_KEY=
CHAINLINK_STREAMS_API_SECRET=

# Mainnet deployment (script/DeployEquis.s.sol). A multisig is strongly recommended for the owner.
EQUIS_OWNER=
EQUIS_GUARDIAN=
EQUIS_TREASURY=

# Don't put deployer private keys here. Import once into an encrypted keystore instead:
#   cast wallet import equis-deployer --interactive
# then deploy with: forge script ... --rpc-url xlayer --account equis-deployer
